# CORAL_DEPLOYMENT_GLM_5_3_INFRASTRUCTURE_REGION=au-syd-1
# CORAL_DEPLOYMENT_GLM_5_3_INFERENCE_COUNTRY=AU
# CORAL_DEPLOYMENT_GLM_5_3_WEIGHT_COUNTRY=AU
# CORAL_DEPLOYMENT_GLM_5_3_WEIGHT_LOCATION=sharon-ai:au-syd-1:coral-weight-vault/glm-5-3
# CORAL_DEPLOYMENT_GLM_5_3_ENABLED=true
# CORAL_DEPLOYMENT_GLM_5_3_SOVEREIGNTY_VERIFIED_BY=
