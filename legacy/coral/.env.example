# =============================================================================
# Coral — Australian Sovereign Open Weights Model API
#
# Copy to .env.local and fill in. NEVER commit a filled-in file.
# Every value below is a placeholder. No real secret belongs in this file.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development

# SQLite database file. Use an absolute path on a persistent Australian volume
# in production.
DATABASE_URL=./data/coral.db

# Shown in the documentation examples on the website.
CORAL_PUBLIC_API_BASE_URL=http://localhost:3000/v1

# Mixed into API key hashes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# WARNING: changing this invalidates every existing API key.
CORAL_API_KEY_PEPPER=replace-with-a-random-32-byte-value

# Upstream inference timeout in milliseconds.
CORAL_UPSTREAM_TIMEOUT_MS=300000

# -----------------------------------------------------------------------------
# Sovereignty controls
# -----------------------------------------------------------------------------
# Permits the development mock backends. Defaults to true outside production and
# false in production. Setting this to true in production means mocks could
# answer customer traffic — do not.
CORAL_ALLOW_DEVELOPMENT_MOCKS=true

# Customer prompts and model responses are never logged. This flag exists so the
# decision would have to be explicit and auditable. Leave it false.
CORAL_LOG_REQUEST_CONTENT=false

# -----------------------------------------------------------------------------
# Model deployments
#
# One block per model. A deployment is only routable when INFERENCE_COUNTRY and
# WEIGHT_COUNTRY are both AU. Anything else is rejected at load and the model is
# reported unavailable — it is NEVER routed offshore.
#
# It is only shown as "Australian sovereign — verified" when all three
# SOVEREIGNTY_VERIFIED_* values are also filled in by a human who checked.
#
# Set ADAPTER=development-mock to run locally with no GPU attached.
# -----------------------------------------------------------------------------

# --- Kimi K3 (kimi-k3) -------------------------------------------------------
CORAL_DEPLOYMENT_KIMI_K3_ADAPTER=development-mock
# CORAL_DEPLOYMENT_KIMI_K3_ENDPOINT=https://kimi-k3.au-syd.example.internal/v1
# CORAL_DEPLOYMENT_KIMI_K3_API_KEY=replace-with-compute-provider-token
# CORAL_DEPLOYMENT_KIMI_K3_UPSTREAM_MODEL_ID=replace-with-backend-model-name
# CORAL_DEPLOYMENT_KIMI_K3_INFRASTRUCTURE_PROVIDER=firmus
# CORAL_DEPLOYMENT_KIMI_K3_INFRASTRUCTURE_REGION=au-syd-1
# CORAL_DEPLOYMENT_KIMI_K3_INFERENCE_COUNTRY=AU
# CORAL_DEPLOYMENT_KIMI_K3_WEIGHT_COUNTRY=AU
# CORAL_DEPLOYMENT_KIMI_K3_WEIGHT_LOCATION=firmus:au-syd-1:coral-weight-vault/kimi-k3
# CORAL_DEPLOYMENT_KIMI_K3_MODEL_VERSION=
# CORAL_DEPLOYMENT_KIMI_K3_CONTEXT_WINDOW=
# CORAL_DEPLOYMENT_KIMI_K3_MODALITIES=text
# CORAL_DEPLOYMENT_KIMI_K3_ENABLED=true
# CORAL_DEPLOYMENT_KIMI_K3_SOVEREIGNTY_VERIFIED_BY=
# CORAL_DEPLOYMENT_KIMI_K3_SOVEREIGNTY_VERIFIED_AT=
# CORAL_DEPLOYMENT_KIMI_K3_SOVEREIGNTY_VERIFICATION_METHOD=
# CORAL_MODEL_KIMI_K3_CREATOR=

